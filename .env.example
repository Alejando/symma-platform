# ===========================================
# Symma Platform - Docker Compose environment
# ===========================================
# Copy this file to .env (next to docker-compose.yml) and fill in every
# empty value. Docker Compose refuses to start while a required secret
# is missing. Generate secrets with: openssl rand -base64 32

# PostgreSQL
POSTGRES_USER=symma_admin
POSTGRES_PASSWORD=
POSTGRES_DB=symma_db
POSTGRES_PORT=5440

# Host ports
API_PORT=4001
WEB_PORT=4000
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# API secrets (no defaults: the API refuses to start without them)
JWT_SECRET=
PIN_HMAC_SECRET=
# Optional API settings
JWT_THERAPIST_EXPIRES_IN=8h
JWT_PATIENT_EXPIRES_IN=7d
ANALYTICS_TIME_ZONE=America/Mexico_City

# Web portal (Auth.js)
AUTH_SECRET=
AUTH_URL=http://localhost:4000

# MinIO (local S3-compatible storage for session snapshots)
MINIO_ROOT_USER=symma_minio
MINIO_ROOT_PASSWORD=
S3_BUCKET=symma-snapshots
S3_REGION=us-east-1
# Signed upload/download URLs carry this host, so it must be reachable by the
# browser and the phone (use the machine's LAN IP for a physical device).
S3_ENDPOINT=http://localhost:9000
