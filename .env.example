# ===========================================
# Symma Platform - Environment Configuration
# ===========================================
# Copy this file to .env and fill in the values

# Database (PostgreSQL)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5440/symma_db?schema=public"
POSTGRES_USER=symma_admin
POSTGRES_PASSWORD=your_secure_password
POSTGRES_DB=symma_db
POSTGRES_PORT=5440

# Services Ports
API_PORT=4001
WEB_PORT=4000

# Environment
NODE_ENV=development
