# API environment configuration. Copy to .env and fill in every value marked REQUIRED.
# The API refuses to start when a REQUIRED variable is missing or blank.

PORT=4001
NODE_ENV=development

# REQUIRED. PostgreSQL connection string (docker-compose exposes Postgres on 5440).
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5440/symma_db?schema=public"

# REQUIRED. Secret used to sign therapist and patient JWTs. Generate with: openssl rand -base64 48
JWT_SECRET=
# Optional token lifetimes (vercel/ms format). Defaults: therapist 8h, patient 7d.
JWT_THERAPIST_EXPIRES_IN=8h
JWT_PATIENT_EXPIRES_IN=7d

# REQUIRED. Secret for the HMAC-SHA256 of patient PINs. Generate with: openssl rand -base64 48
# Changing it invalidates every stored PIN; existing SHA-256 hashes are migrated with
# `pnpm --filter api migrate:access-codes` (see apps/api/README.md).
PIN_HMAC_SECRET=

# IANA time zone used to group sessions into calendar days (streaks, adherence). Default: UTC.
ANALYTICS_TIME_ZONE=America/Mexico_City

# Snapshot storage (S3 or MinIO). Optional: without these the API starts and the snapshot
# endpoints answer 503. S3_ENDPOINT and S3_FORCE_PATH_STYLE=true are only needed for MinIO.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
