  "info": {
    "title": "Symma Platform API",
    "description": "API documentation for Web Dashboard and Mobile App",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "LoginDto": {
        "type": "object",
        "properties": {}
      },
      "MobileLoginDto": {
        "type": "object",
        "properties": {}
      },
      "CreatePatientDto": {
        "type": "object",
        "properties": {}
      },
      "UpdatePatientDto": {
        "type": "object",
        "properties": {}
      },
      "CreateRoutineDto": {
        "type": "object",
        "properties": {}
      },
      "UpdateRoutineDto": {
        "type": "object",
        "properties": {}
      },
      "CreateExerciseDto": {
        "type": "object",
        "properties": {}
      },
      "UpdateExerciseDto": {
        "type": "object",
        "properties": {}
      },
      "ActiveRoutineExerciseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "keyName": {
            "type": "string"
          },
          "description": {
            "type": "object"
          },
          "type": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "mobileModule": {
            "type": "object",
            "description": "Mobile module for strategy selection (SMILE, BROWS, JAW, KISS, EYES, EYES_INVERSE)"
          },
          "assetAnimationUrl": {
            "type": "object"
          },
          "assetTutorialVideoUrl": {
            "type": "object"
          }
        },
        "required": [
          "id",
          "name",
          "keyName",
          "type",
          "category"
        ]
      },
      "ActiveRoutineItemDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "orderIndex": {
            "type": "number"
          },
          "sets": {
            "type": "number",
            "description": "Number of sets for this exercise"
          },
          "repsPerSet": {
            "type": "number",
            "description": "Number of repetitions per set"
          },
          "targetHoldSeconds": {
            "type": "number",
            "description": "Hold time in seconds (0 for isotonic exercises)"
          },
          "restBetweenSets": {
            "type": "number",
            "description": "Rest time between sets in seconds"
          },
          "difficultyLevel": {
            "type": "number",
            "description": "Difficulty level multiplier (1.0 = normal)"
          },
          "strictMode": {
            "type": "boolean",
            "description": "Whether strict mode is enabled"
          },
          "exercise": {
            "$ref": "#/components/schemas/ActiveRoutineExerciseDto"
          }
        },
        "required": [
          "id",
          "orderIndex",
          "sets",
          "repsPerSet",
          "targetHoldSeconds",
          "restBetweenSets",
          "difficultyLevel",
          "strictMode",
          "exercise"
        ]
      },
      "ActiveRoutineResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "startDate": {
            "type": "string"
          },
          "endDate": {
            "type": "object"
          },
          "status": {
            "type": "string"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ActiveRoutineItemDto"
            }
          }
        },
        "required": [
          "id",
          "name",
          "startDate",
          "status",
          "items"
        ]
      },
      "SessionItemDto": {
        "type": "object",
        "properties": {
          "exerciseId": {
            "type": "string"
          },
          "repsCompleted": {
            "type": "number"
          },
          "difficulty": {
            "type": "number",
            "default": 0
          },
          "averageAccuracy": {
            "type": "number",
            "description": "Average symmetry score (0-100)"
          },
          "seriesData": {
            "type": "object",
            "description": "Detailed series data"
          }
        },
        "required": [
          "exerciseId",
          "repsCompleted"
        ]
      },
      "CreateSessionDto": {
        "type": "object",
        "properties": {
          "routineId": {
            "type": "string"
          },
          "startTime": {
            "type": "string"
          },
          "endTime": {
            "type": "string"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SessionItemDto"
            }
          }
        },
        "required": [
          "routineId",
          "startTime",
          "endTime",
          "items"
        ]
      }
    }
  }
