# Web portal environment (Next.js + Auth.js)
# Copy this file to .env.local and fill in every empty value.

# Secret used by Auth.js to encrypt the session cookie (the API JWT lives inside it).
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# Public URL of the portal; Auth.js uses it to build callback URLs.
AUTH_URL=http://localhost:4000

# Base URL of the NestJS API, used by the Next.js server (not by the browser).
NEXT_PUBLIC_API_URL=http://localhost:4001
